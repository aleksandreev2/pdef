{
  "name": "pdfmaker-mobile",
  "productName": "PDFMaker Mobile",
  "version": "3.0.0",
  "description": "Сборка PDF, EPUB, FB2, MOBI, AZW3 и TXT из отдельных глав",
  "main": "src/main/main.js",
  "author": "Дом Некроманта",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "electron .",
    "dev": "electron . --dev",
    "fonts": "node scripts/fetch-fonts.mjs",
    "kindle-tools": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-kindle.ps1",
    "dist": "electron-builder --win --x64",
    "pack": "node scripts/pack.js"
  },
  "dependencies": {
    "@lingo-reader/mobi-parser": "0.4.6",
    "@resvg/resvg-js": "2.6.2",
    "fast-xml-parser": "^4.5.3",
    "htmlparser2": "9.1.0",
    "iconv-lite": "^0.6.3",
    "jschardet": "^3.1.4",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^4.10.38",
    "pdfkit": "^0.16.0",
    "xmllint-wasm": "5.3.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ru.domnekromanta.pdfmaker",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "allowScripts": {
    "electron": true
  }
}
